# MarketNiora environment variables
# Copy to .env and fill real values. Never commit .env.

# Database (NON-PROD CLONE ONLY for DB-backed auth stores)
# DB-backed auth is enabled only when MARKETNIORA_DB_TARGET=NON_PROD.
# The runtime guard also requires the approved non-prod Supabase project ref.
MARKETNIORA_DB_TARGET=NON_PROD
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Google OIDC (per ODR-2026-001)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback
GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# Owner bootstrap — comma-separated emails
OWNER_EMAILS=

# Session
SESSION_TTL_HOURS=168

# KMS (non-prod auth secret encryption uses local-dev only; production KMS remains NOT_DEFINED)
KMS_PROVIDER=local-dev
KMS_LOCAL_MASTER_KEY=
KMS_LOCAL_MASTER_KEY=

# Provider (upstox) — configured later
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=

# Telegram (notification-only per Blueprint §17)
TELEGRAM_BOT_TOKEN=
